# Contoh variabel lingkungan Karir (proyek Firebase karir-9d53a).
# Salin file ini menjadi web/.env.local untuk pengembangan lokal, atau
# pasang tiap variabel sebagai env di Vercel untuk produksi.
#
# File ini HANYA berisi placeholder — jangan pernah menulis nilai asli
# di sini. Nilai asli hanya ada di .env.local (gitignored) dan di env
# Vercel. Variabel bertanda WAJIB harus terisi supaya fitur yang
# bersangkutan jalan; yang bertanda OPSIONAL boleh kosong (fiturnya
# mati atau memakai pengganti, sesuai keterangan tiap variabel).
# CI tidak memakai nilai asli: build, tes, dan smoke memakai nilai
# dummy (lihat .github/workflows/app.yml).

# ---------------------------------------------------------------------------
# Konfigurasi klien publik — WAJIB (6 variabel)
# Nilai-nilai ini bisa dilihat siapa pun yang membuka aplikasi; keamanan
# data datang dari aturan Firestore dan Firebase Auth, bukan dari
# nilai-nilai ini. Diambil dari Firebase Console > Project settings.
# ---------------------------------------------------------------------------

# Kunci API web Firebase
NEXT_PUBLIC_FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY
# Domain auth Firebase, mis. karir-9d53a.firebaseapp.com
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=YOUR_FIREBASE_AUTH_DOMAIN
# ID proyek Firebase
NEXT_PUBLIC_FIREBASE_PROJECT_ID=YOUR_FIREBASE_PROJECT_ID
# Bucket storage Firebase
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=YOUR_FIREBASE_STORAGE_BUCKET
# ID pengirim Firebase Cloud Messaging
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=YOUR_FIREBASE_MESSAGING_SENDER_ID
# ID aplikasi web Firebase
NEXT_PUBLIC_FIREBASE_APP_ID=YOUR_FIREBASE_APP_ID

# ---------------------------------------------------------------------------
# Rahasia server — WAJIB di produksi (4 variabel)
# Jangan pernah menulis nilai asli variabel-variabel ini di file yang
# di-commit, di issue, atau di pull request.
# ---------------------------------------------------------------------------

# Service account Firebase, string JSON SATU BARIS (tanpa baris baru di
# luar \n di dalam private_key). Dipakai route server untuk menulis ke
# Firestore (cron cek ulang, pembersihan retensi, analitik, cadangan).
# Diambil dari Firebase Console > Project settings > Service accounts >
# Generate new private key. Tanpa variabel ini, cron dan penulisan
# server gagal; cadangan Firestore juga butuh variabel ini.
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"YOUR_PROJECT_ID","private_key_id":"YOUR_PRIVATE_KEY_ID","private_key":"-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY\n-----END PRIVATE KEY-----\n","client_email":"YOUR_SERVICE_ACCOUNT_EMAIL","client_id":"YOUR_CLIENT_ID"}
# Rahasia pengaman endpoint cron (string acak panjang, dibuat sendiri).
# Vercel Cron mengirimnya sebagai header Authorization Bearer; route
# cron MENOLAK semua request bila variabel ini kosong (fail-closed),
# jadi cek ulang otomatis dan pembersihan tidak jalan tanpanya.
CRON_SECRET=YOUR_CRON_SECRET
# Rahasia penanda tangan token API (string acak panjang, dibuat sendiri).
# Dipakai /api/token untuk menerbitkan token dan /api/index untuk
# memverifikasinya. Tanpa variabel ini, /api/token menolak menerbitkan
# token (fail-closed) dan pencarian di browser kehilangan indeksnya.
API_TOKEN_SECRET=YOUR_API_TOKEN_SECRET
# Garam hash pengunjung dan batas laju (string acak panjang, dibuat
# sendiri). Tanpa variabel ini, hash pengunjung tidak bisa dibuat dan
# batas laju API dilewati — endpoint tetap jalan, tapi tanpa
# perlindungan batas laju.
ANALYTICS_SALT=YOUR_ANALYTICS_SALT

# ---------------------------------------------------------------------------
# Notifikasi Telegram — OPSIONAL (2 variabel, sepasang)
# Bila keduanya kosong, cron tetap jalan tetapi tidak mengirim pesan
# Telegram soal lowongan baru dan batas lamar yang dekat.
# ---------------------------------------------------------------------------

# Token bot Telegram yang mengirim notifikasi (dari @BotFather)
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
# ID chat tujuan pesan notifikasi (chat pribadi atau grup)
TELEGRAM_CHAT_ID=YOUR_TELEGRAM_CHAT_ID

# ---------------------------------------------------------------------------
# Notifikasi web push — OPSIONAL (2 variabel, sepasang; T10)
# Pasangan kunci VAPID untuk mengirim notifikasi push ke browser
# pelanggan. Dibuat dengan `npx web-push generate-vapid-keys`.
# Bila keduanya kosong, langganan tetap bisa disimpan tetapi digest
# push tidak dikirim (cron mencatat "skipped-no-vapid"). Kunci
# privat HANYA di env server (encrypted di Vercel); kunci publik
# memang dibagikan ke browser lewat env NEXT_PUBLIC_*.
# ---------------------------------------------------------------------------

# Kunci privat VAPID (RAHASIA — jangan pernah di-commit)
VAPID_PRIVATE_KEY=YOUR_VAPID_PRIVATE_KEY
# Kunci publik VAPID (dibagikan ke browser, bukan rahasia)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=YOUR_VAPID_PUBLIC_KEY

# ---------------------------------------------------------------------------
# Penyimpanan batas laju — OPSIONAL (2 pasang, salah satu cukup)
# Batas laju bersama memakai penyimpanan pertama yang tersedia:
# pasangan KV_* dulu, lalu pasangan UPSTASH_*, lalu Firestore, lalu
# memori. Tanpa keempat variabel ini, batas laju tetap jalan lewat
# Firestore (lalu memori) — tidak ada fitur yang mati.
# ---------------------------------------------------------------------------

# URL REST Vercel KV (Upstash)
KV_REST_API_URL=YOUR_KV_REST_API_URL
# Token REST Vercel KV (Upstash)
KV_REST_API_TOKEN=YOUR_KV_REST_API_TOKEN
# URL REST Upstash Redis (alternatif pasangan KV_* di atas)
UPSTASH_REDIS_REST_URL=YOUR_UPSTASH_REDIS_REST_URL
# Token REST Upstash Redis (alternatif pasangan KV_* di atas)
UPSTASH_REDIS_REST_TOKEN=YOUR_UPSTASH_REDIS_REST_TOKEN

# ---------------------------------------------------------------------------
# Observabilitas Sentry — OPSIONAL (2 variabel + 1 slug; P-06)
# Akun Sentry Developer gratis, proyek "karir", platform Next.js.
# Langkah pembuatan akun + DSN: docs/sentry-setup.md. Tanpa DSN, SDK
# Sentry nonaktif diam-diam dan semua jalur observabilitas lain
# (log terstruktur, insiden Firestore, heartbeat) tetap jalan.
# ---------------------------------------------------------------------------

# DSN Sentry server (dipakai instrumentation + sentry.server.config.js)
SENTRY_DSN=YOUR_SENTRY_DSN
# DSN Sentry klien (dipakai pelapor error browser; bukan rahasia —
# DSN klien memang terlihat di bundle, sama seperti API key Firebase)
NEXT_PUBLIC_SENTRY_DSN=YOUR_SENTRY_DSN
# Slug cron monitor Sentry untuk recheck harian (bawaan: karir-recheck).
# Monitor dibuat otomatis Sentry pada check-in pertama yang membawa
# konfigurasi monitor; parent mengaktifkan alarmnya di dasbor Sentry.
SENTRY_CRON_MONITOR_SLUG=karir-recheck

# ---------------------------------------------------------------------------
# Tes asap — OPSIONAL (1 variabel)
# ---------------------------------------------------------------------------

# Alamat dasar server yang diperiksa web/scripts/smoke-check.mjs.
# Bawaan bila kosong: http://localhost:3000.
BASE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Khusus pengujian — OPSIONAL (1 variabel)
# Bukan konfigurasi deployment; hanya untuk mengarahkan skrip impor
# dan cadangan ke server Firestore tiruan saat pengujian.
# ---------------------------------------------------------------------------

# Timpa alamat dasar REST Firestore (bawaan: firestore.googleapis.com)
FIRESTORE_BASE=https://firestore.googleapis.com/v1/projects/YOUR_PROJECT_ID/databases/(default)/documents
