# Salin file ini menjadi web/.env.local dan isi dengan nilai dari Firebase Console, proyek karir-9d53a.
# Enam variabel ini adalah konfigurasi klien publik; nilainya bisa dilihat siapa pun yang membuka aplikasi.
# Keamanan data datang dari aturan Firestore dan Firebase Auth, bukan dari nilai-nilai ini.
# Jangan pernah menulis FIREBASE_SERVICE_ACCOUNT atau CRON_SECRET di file ini; keduanya hanya dipasang sebagai env di Vercel.

# Kunci API web Firebase
NEXT_PUBLIC_FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY
# Domain auth Firebase, mis. karir-9d53a.firebaseapp.com
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=YOUR_FIREBASE_AUTH_DOMAIN
# ID proyek Firebase
NEXT_PUBLIC_FIREBASE_PROJECT_ID=YOUR_FIREBASE_PROJECT_ID
# Bucket storage Firebase
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=YOUR_FIREBASE_STORAGE_BUCKET
# ID pengirim Firebase Cloud Messaging
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=YOUR_FIREBASE_MESSAGING_SENDER_ID
# ID aplikasi web Firebase
NEXT_PUBLIC_FIREBASE_APP_ID=YOUR_FIREBASE_APP_ID
