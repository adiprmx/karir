rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    /* Admin = akun yang punya custom claim admin: true di Firebase
     * Auth (dipasang owner lewat Admin API, bukan dari pendaftaran
     * publik). Pendaftar biasa tidak punya klaim ini, jadi tidak
     * bisa menulis data atau membaca koleksi admin. */
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    match /companies/{doc} {
      allow read: if true;
      // Tulis dan hapus hanya untuk admin, dan isi dokumen harus valid:
      // no angka, nama perusahaan ada, status salah satu dari 4 nilai,
      // dan 9 kolom wajib ada.
      allow create, update: if isAdmin()
        && request.resource.data.no is int
        && request.resource.data.perusahaan is string
        && request.resource.data.perusahaan.size() > 0
        && request.resource.data.perusahaan.size() < 200
        && request.resource.data.status in [
          'Ada lowongan',
          'Tidak ada lowongan',
          'Tidak dapat diverifikasi',
          'Portal tidak bisa dibuka'
        ]
        // Batas lamar opsional ("YYYY-MM-DD"); bila ada, harus string.
        && (!request.resource.data.keys().hasAny(['batas_lamar'])
          || request.resource.data.batas_lamar is string)
        && request.resource.data.keys().hasAll([
          'no', 'perusahaan', 'kategori', 'link_karir', 'status',
          'tanggal_cek', 'catatan', 'lokasi', 'posisi'
        ]);
      allow delete: if isAdmin();
    }
    // Alert notifikasi (ditulis cron cek ulang harian dan dibaca watcher
    // agent-side): siapa pun boleh membaca seperti changes, tulis hanya
    // lewat service account (melewati rules) atau admin.
    // Entri yang sudah tercatat tidak bisa diubah atau dihapus dari
    // klien, supaya status terkirim tidak bisa dipalsukan.
    // Pengecualian: alert kuota (type 'quota', id quota-70-YYYY-MM-DD)
    // boleh dibuat server web lewat API key publik saat estimasi baca
    // mencapai 70% kuota harian — bentuknya dikekang ketat (companyNo
    // 0, perusahaan kosong, readsEstimate >= 35000, percent >= 70)
    // dan id deterministik per hari mencegah duplikat.
    match /alerts/{doc} {
      allow read: if true;
      allow create: if isAdmin()
        && request.resource.data.keys().hasAll([
          'type', 'companyNo', 'perusahaan', 'sent', 'createdAt'
        ])
        && request.resource.data.type in ['new-target', 'deadline']
        && request.resource.data.companyNo is int
        && request.resource.data.perusahaan is string
        && request.resource.data.sent is bool
        && request.resource.data.createdAt is string;
      allow create: if request.resource.data.type == 'quota'
        && doc.matches('^quota-70-[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.keys().hasOnly([
          'type', 'companyNo', 'perusahaan', 'sent', 'createdAt',
          'readsEstimate', 'percent'
        ])
        && request.resource.data.companyNo == 0
        && request.resource.data.perusahaan == ''
        && request.resource.data.sent == false
        && request.resource.data.createdAt is string
        && request.resource.data.readsEstimate is int
        && request.resource.data.readsEstimate >= 35000
        && request.resource.data.percent is int
        && request.resource.data.percent >= 70;
      allow update, delete: if false;
    }
    // Marker kesegaran (meta/lastChange, arsitektur seed-first S3):
    // {rev, updatedAt, counterDay, refillsToday, readsEstimate}.
    // Dibaca server web tiap jendela TTL 5 menit (1 baca) untuk
    // memutuskan refill, dan dibaca panel admin untuk tampilan
    // pemakaian kuota — karena itu baca terbuka untuk siapa pun
    // (isinya hanya angka, bukan data pengguna).
    // Tulis rev hanya dua jalur: service account (cron, impor —
    // melewati rules) dan admin (naik tepat 1, pencacah tidak
    // berubah). Server web lewat API key publik HANYA boleh
    // menaikkan pencacah refill: rev dan updatedAt tidak boleh
    // berubah lewat jalur itu, jadi tidak ada yang bisa memaksa
    // refill dari luar. Hari sama: refillsToday naik tepat 1 dan
    // estimasi naik. Ganti hari: pencacah mulai lagi dari 1.
    // Sisa risiko: siapa pun yang punya API key publik bisa
    // menaikkan atau me-reset pencacah (estimasi jadi tidak akurat)
    // — tapi tidak bisa memaksa refill atau menghabiskan kuota baca,
    // dan alert kuota tetap idempotent per hari.
    match /meta/lastChange {
      allow read: if true;
      allow create: if isAdmin()
        && request.resource.data.rev == 1
        && request.resource.data.updatedAt is string
        && request.resource.data.counterDay is string
        && request.resource.data.counterDay.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.refillsToday == 0
        && request.resource.data.readsEstimate == 0
        && request.resource.data.keys().hasOnly([
          'rev', 'updatedAt', 'counterDay', 'refillsToday', 'readsEstimate'
        ]);
      allow update: if isAdmin()
        && request.resource.data.rev == resource.data.rev + 1
        && request.resource.data.updatedAt is string
        && request.resource.data.counterDay == resource.data.counterDay
        && request.resource.data.refillsToday == resource.data.refillsToday
        && request.resource.data.readsEstimate == resource.data.readsEstimate
        && request.resource.data.keys().hasOnly([
          'rev', 'updatedAt', 'counterDay', 'refillsToday', 'readsEstimate'
        ]);
      allow update: if request.resource.data.rev == resource.data.rev
        && request.resource.data.updatedAt == resource.data.updatedAt
        && request.resource.data.keys().hasOnly([
          'rev', 'updatedAt', 'counterDay', 'refillsToday', 'readsEstimate'
        ])
        && ((request.resource.data.counterDay == resource.data.counterDay
          && request.resource.data.refillsToday == resource.data.refillsToday + 1
          && request.resource.data.readsEstimate is int
          && request.resource.data.readsEstimate > resource.data.readsEstimate)
        || (request.resource.data.counterDay != resource.data.counterDay
          && request.resource.data.counterDay.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && request.resource.data.refillsToday == 1
          && request.resource.data.readsEstimate is int
          && request.resource.data.readsEstimate > 0));
      allow delete: if false;
    }
    // Snapshot internal cron (meta/targets: daftar nomor perusahaan
    // yang ada lowongannya run sebelumnya). Hanya service account
    // yang menulis dan membaca (melewati rules); klien tidak
    // mendapat akses sama sekali. Dokumen meta lain di luar
    // lastChange juga tertutup.
    match /meta/{doc} {
      allow read, write: if false;
    }
    // Batas laju bersama (lib/rate-limit.js, store Firestore): dokumen
    // per hash pengunjung harian, berisi larik waktu hit dan cap
    // waktu tulis balik. Tidak ada IP mentah di sini, hanya angka
    // waktu. Tulis lewat API key publik, jadi bentuknya dibatasi
    // ketat: larik maks 60 angka dan cap waktu wajib ada. Baca
    // terbuka karena isinya hanya waktu hit, bukan data pengunjung.
    match /rate_limits/{doc} {
      allow read: if true;
      allow create, update: if request.resource.data.keys().hasAll([
          'hits', 'updatedAt'
        ])
        && request.resource.data.hits is list
        && request.resource.data.hits.size() <= 60
        && request.resource.data.updatedAt is timestamp;
      allow delete: if false;
    }
    // Jejak audit: hanya admin yang bisa membaca dan menulis, tidak
    // bisa mengubah atau menghapus entri yang sudah tercatat.
    match /audit_logs/{doc} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update, delete: if false;
    }
    // Laporan tautan mati dari pengunjung: siapa pun boleh mengirim satu
    // laporan berbentuk benar, tapi hanya admin yang bisa membacanya.
    match /reports/{doc} {
      allow read: if isAdmin();
      allow create: if request.resource.data.keys().hasAll([
          'no', 'perusahaan', 'alasan', 'dibuat'
        ])
        && request.resource.data.no is int
        && request.resource.data.alasan is string
        && request.resource.data.alasan.size() > 0
        && request.resource.data.alasan.size() < 500;
      allow update, delete: if false;
    }
    // Umpan perubahan status (ditulis cron cek ulang harian): siapa pun
    // boleh membaca, hanya admin yang boleh mencatat, dan entri
    // yang sudah tercatat tidak bisa diubah atau dihapus.
    match /changes/{doc} {
      allow read: if true;
      allow create: if isAdmin()
        && request.resource.data.keys().hasAll([
          'companyNo', 'perusahaan', 'from', 'to', 'checkedAt', 'createdAt'
        ])
        && request.resource.data.companyNo is int
        && request.resource.data.perusahaan is string
        && request.resource.data.perusahaan.size() > 0
        && request.resource.data.perusahaan.size() < 200
        && request.resource.data.from in [
          'Ada lowongan',
          'Tidak ada lowongan',
          'Tidak dapat diverifikasi',
          'Portal tidak bisa dibuka'
        ]
        && request.resource.data.to in [
          'Ada lowongan',
          'Tidak ada lowongan',
          'Tidak dapat diverifikasi',
          'Portal tidak bisa dibuka'
        ]
        && request.resource.data.checkedAt is string
        && request.resource.data.createdAt is string;
      allow update, delete: if false;
    }
    // Pelacak lamaran per akun: hanya pemilik akun yang boleh baca
    // dan tulis, satu dokumen per perusahaan.
    match /user_trackers/{uid}/items/{companyNo} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.companyNo is int
        && request.resource.data.companyNo >= 1
        && request.resource.data.companyNo <= 10000
        && request.resource.data.status in [
          'Ditandai', 'Sudah dilamar', 'Dipanggil', 'Ditolak'
        ]
        && request.resource.data.tanggal is string
        && request.resource.data.tanggal.size() <= 10
        && request.resource.data.catatan is string
        && request.resource.data.catatan.size() <= 200;
    }
    // Profil akun: tulis hanya pemiliknya; baca hanya pemiliknya
    // atau admin. Dipakai dasbor admin untuk menampilkan akun tanpa
    // menyimpan email di dalam event pengunjung.
    match /user_profiles/{uid} {
      allow read: if request.auth != null
        && (request.auth.uid == uid || isAdmin());
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 200
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 100
        && request.resource.data.updatedAt is string;
      allow delete: if false;
    }
    // Event analitik pengunjung anonim: siapa pun boleh mencatat satu
    // event berbentuk benar, tanpa field IP apa pun. Hash IP (64 heksa)
    // dipakai untuk hitung pengunjung unik per hari, bukan IP mentah.
    // Baca, ubah, dan hapus hanya untuk admin.
    match /analytics_events/{doc} {
      allow read, update, delete: if isAdmin();
      allow create: if request.resource.data.keys().hasAll([
          'type', 'path', 'visitorHash', 'ts', 'day'
        ])
        && request.resource.data.type in [
          'pageview', 'search', 'detail', 'portal_click', 'tracker_mark', 'filter'
        ]
        && request.resource.data.path is string
        && request.resource.data.path.size() > 0
        && request.resource.data.path.size() <= 200
        && request.resource.data.visitorHash is string
        && request.resource.data.visitorHash.matches('^[0-9a-f]{64}$')
        && request.resource.data.ts is string
        && request.resource.data.day is string
        && (!('q' in request.resource.data)
          || (request.resource.data.q is string
            && request.resource.data.q.size() <= 200))
        && (!('companyNo' in request.resource.data)
          || request.resource.data.companyNo is int)
        && (!('action' in request.resource.data)
          || (request.resource.data.action is string
            && request.resource.data.action.size() <= 50))
        && (!('visitor' in request.resource.data)
          || (request.resource.data.visitor is string
            && request.resource.data.visitor.size() <= 64))
        && (!('uid' in request.resource.data)
          || (request.resource.data.uid is string
            && request.resource.data.uid.size() > 0
            && request.resource.data.uid.size() <= 128))
        && (!('uaFlag' in request.resource.data)
          || request.resource.data.uaFlag is bool)
        && !('email' in request.resource.data)
        && !('ip' in request.resource.data)
        && !('x-forwarded-for' in request.resource.data)
        && !('userAgent' in request.resource.data);
    }
  }
}
