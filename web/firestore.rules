rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /companies/{doc} {
      allow read: if true;
      // Tulis hanya untuk admin yang login, dan isi dokumen harus valid:
      // no angka, nama perusahaan ada, status salah satu dari 6 nilai,
      // dan 9 kolom wajib ada.
      allow create, update: if request.auth != null
        && request.resource.data.no is int
        && request.resource.data.perusahaan is string
        && request.resource.data.perusahaan.size() > 0
        && request.resource.data.perusahaan.size() < 200
        && request.resource.data.status in [
          'Ada lowongan target',
          'Ada lowongan target (tidak cocok)',
          'Tidak ada lowongan target',
          'Tidak ada lowongan terlihat',
          'Tidak dapat diverifikasi',
          'Portal tidak bisa dibuka'
        ]
        && request.resource.data.keys().hasAll([
          'no', 'perusahaan', 'kategori', 'link_karir', 'status',
          'tanggal_cek', 'catatan', 'lokasi', 'posisi'
        ]);
      allow delete: if request.auth != null;
    }
    // Jejak audit: admin bisa membaca dan menulis, tidak bisa mengubah
    // atau menghapus entri yang sudah tercatat.
    match /audit_logs/{doc} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if false;
    }
    // Laporan tautan mati dari pengunjung: siapa pun boleh mengirim satu
    // laporan berbentuk benar, tapi tidak bisa membaca atau mengubahnya.
    match /reports/{doc} {
      allow read: if request.auth != null;
      allow create: if request.resource.data.keys().hasAll([
          'no', 'perusahaan', 'alasan', 'dibuat'
        ])
        && request.resource.data.no is int
        && request.resource.data.alasan is string
        && request.resource.data.alasan.size() > 0
        && request.resource.data.alasan.size() < 500;
      allow update, delete: if false;
    }
    // Umpan perubahan status (ditulis cron cek ulang harian): siapa pun
    // boleh membaca, hanya admin yang login boleh mencatat, dan entri
    // yang sudah tercatat tidak bisa diubah atau dihapus.
    match /changes/{doc} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.keys().hasAll([
          'companyNo', 'perusahaan', 'from', 'to', 'checkedAt', 'createdAt'
        ])
        && request.resource.data.companyNo is int
        && request.resource.data.perusahaan is string
        && request.resource.data.perusahaan.size() > 0
        && request.resource.data.perusahaan.size() < 200
        && request.resource.data.from in [
          'Ada lowongan target',
          'Ada lowongan target (tidak cocok)',
          'Tidak ada lowongan target',
          'Tidak ada lowongan terlihat',
          'Tidak dapat diverifikasi',
          'Portal tidak bisa dibuka'
        ]
        && request.resource.data.to in [
          'Ada lowongan target',
          'Ada lowongan target (tidak cocok)',
          'Tidak ada lowongan target',
          'Tidak ada lowongan terlihat',
          'Tidak dapat diverifikasi',
          'Portal tidak bisa dibuka'
        ]
        && request.resource.data.checkedAt is string
        && request.resource.data.createdAt is string;
      allow update, delete: if false;
    }
  }
}
