{
  "dependencies": {
    "firebase": "^13.2.0",
    "leaflet": "^1.9.4",
    "next": "^16.4.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "web-push": "^4.0.0"
  },
  "description": "Karir: alat cari kanal lowongan kerja. Next.js + Firestore.",
  "engines": {
    "node": "24.x"
  },
  "name": "karir-web",
  "private": true,
  "scripts": {
    "build": "next build",
    "check:bundle": "node scripts/check-bundle-budget.mjs",
    "dev": "next dev",
    "lint": "eslint .",
    "start": "next start",
    "test": "node --test \"lib/**/*.test.js\" \"app/**/*.test.js\" \"scripts/**/*.test.js\"",
    "test:coverage": "NODE_V8_COVERAGE=./coverage node --test --experimental-test-coverage --test-coverage-lines=90 --test-coverage-functions=89 --test-coverage-branches=87 --test-coverage-include=\"lib/**/*.js\" --test-coverage-include=\"app/**/*.js\" --test-coverage-include=\"scripts/**/*.mjs\" --test-coverage-exclude=\"**/*.test.js\" --test-coverage-exclude=\"lib/test-stubs/**\" --test-coverage-exclude=\"lib/*loader*.mjs\" --test-coverage-exclude=\"lib/*stub*.mjs\" \"lib/**/*.test.js\" \"app/**/*.test.js\" \"scripts/**/*.test.js\"",
    "test:e2e": "playwright test"
  },
  "type": "module",
  "version": "2.17.0",
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "eslint": "^10.14.0",
    "eslint-config-next": "^16.4.6"
  }
}
